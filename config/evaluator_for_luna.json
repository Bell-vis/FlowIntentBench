{
  "server_config": "config.toml",
  "provider": "yiapi",
  "model": "gpt-5.6-sol",
  "model_configuration": {
    "wire_api": "chat_completions",
    "execution_backend": "OPENAI_CHAT_COMPLETIONS",
    "reasoning_effort": "low",
    "max_completion_tokens": 8192,
    "parallel_tool_calls": false,
    "structured_output_mode": "strict_json_schema",
    "structured_output_capability": "STRICT_JSON_SCHEMA"
  },
  "continuation_agent": "gpt-5.6-terra-xhigh-chat",
  "continuation_timeout_seconds": 180,
  "continuation_attempts": 4,
  "continuation_retry_backoff_seconds": 2,
  "continuation_rate_limit_backoff_seconds": 15,
  "continuation_rate_limit_max_backoff_seconds": 60,
  "continuation_retry_jitter_seconds": 0,
  "timeout_seconds": 180,
  "transport_attempts": 4,
  "retry_backoff_seconds": 2,
  "rate_limit_backoff_seconds": 15,
  "rate_limit_max_backoff_seconds": 60,
  "retry_jitter_seconds": 0,
  "max_continuation_hops": 8,
  "evaluator_circuit_breaker_threshold": 3,
  "evaluator_circuit_breaker_cooldown_seconds": 120,
  "evaluator_infrastructure_attempt_cap": 3,
  "collection_infrastructure_attempt_cap": 4,
  "collection_case_timeout_seconds": 1800,
  "collection_process_timeout_seconds": 0,
  "collection_provider_retries": 5,
  "collection_provider_retry_backoff_seconds": 1,
  "collection_rate_limit_backoff_seconds": 15,
  "collection_rate_limit_max_backoff_seconds": 60,
  "collection_circuit_breaker_threshold": 3,
  "collection_circuit_breaker_cooldown_seconds": 120,
  "retry_network_noncompletion": true,
  "case_process_timeout_seconds": 1800,
  "global_evaluation_deadline_seconds": 86400,
  "inter_case_delay_seconds": 5
}
